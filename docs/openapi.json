{
  "components": {
    "schemas": {
      "Csv": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "maxLength": 100000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "Csv",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Login": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "pattern": "^[A-Za-z0-9_.-]{1,100}$",
            "title": "Login",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "title": "Login",
        "type": "object"
      },
      "Mapping": {
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 25,
            "title": "Aliases",
            "type": "object"
          }
        },
        "required": [
          "aliases"
        ],
        "title": "Mapping",
        "type": "object"
      },
      "Period": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "format": "date",
            "title": "End",
            "type": "string"
          },
          "start": {
            "format": "date",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "Period",
        "type": "object"
      },
      "Scenario": {
        "additionalProperties": false,
        "properties": {
          "cash_in_percent": {
            "default": 0,
            "maximum": 200.0,
            "minimum": -100.0,
            "title": "Cash In Percent",
            "type": "integer"
          },
          "expense_percent": {
            "default": 0,
            "maximum": 200.0,
            "minimum": -100.0,
            "title": "Expense Percent",
            "type": "integer"
          },
          "revenue_percent": {
            "default": 0,
            "maximum": 200.0,
            "minimum": -100.0,
            "title": "Revenue Percent",
            "type": "integer"
          }
        },
        "title": "Scenario",
        "type": "object"
      },
      "User": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "pattern": "^[A-Za-z0-9_.-]{1,100}$",
            "title": "Login",
            "type": "string"
          },
          "name": {
            "maxLength": 80,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "enum": [
              "FINANCIAL_ANALYST",
              "DATA_ANALYST",
              "DATA_ENGINEER",
              "DATA_STEWARD",
              "ADMIN"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password",
          "name",
          "role"
        ],
        "title": "User",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
